# ---------------------------------------------------------------------
# Frontend environment (Vite) - copy to `frontend/.env.local` to use.
# NEVER put AWS credentials here. VITE_* values are embedded in the
# browser bundle: only public, non-secret values belong in this file.
# ---------------------------------------------------------------------

# Base URL of the FastAPI backend (REST).
# Leave EMPTY to use the Vite dev proxy (see VITE_PROXY_TARGET below).
# VITE_API_URL=http://localhost:8000

# WebSocket endpoint for live alerts + metrics.
# Leave EMPTY to derive it from the page origin via the Vite proxy.
# VITE_WS_URL=ws://localhost:8000/ws

# Dev-server proxy target, used when VITE_API_URL / VITE_WS_URL are empty.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Demo mode: auto (default) | always | never
#   auto   -> use the real backend, fall back to demo data if it is down
#   always -> never touch the backend (perfect for a judge demo)
#   never  -> real backend only, show an error if it is unreachable
# VITE_DEMO_MODE=auto
