# ---------------------------------------------------------------------
# Real-Time Log Anomaly Detector - environment configuration
# Copy to `.env` in the project root and adjust as needed.
# NEVER put real credentials in this file.
# ---------------------------------------------------------------------

# --- Log file to monitor -------------------------------------------------
LOG_FILE=./backend/data/demo.log
LOG_POLL_INTERVAL=0.2
LOG_MAX_LINE_BYTES=8192

# --- Detection -----------------------------------------------------------
# Sliding window length in seconds and how often it is evaluated.
DETECT_WINDOW_SECONDS=20
DETECT_EVALUATE_EVERY=2
# Anomaly when error_rate > baseline_mean + SIGMA_MULTIPLIER * baseline_std
DETECT_SIGMA_MULTIPLIER=3.0
# Absolute floor for the alert threshold (never alert below 5% errors)
DETECT_MIN_ERROR_RATE=0.05
# Minimum events required inside a window before it can raise an alert
DETECT_MIN_SAMPLES=20
# Windows used to learn the initial baseline
DETECT_WARMUP_WINDOWS=2
# Number of trailing windows kept as the baseline
DETECT_BASELINE_WINDOW=15
# Consecutive normal evaluations before an incident is closed
DETECT_RECOVERY_WINDOWS=2

# --- Severity ------------------------------------------------------------
# overage = (error_rate - threshold) / threshold
SEVERITY_MEDIUM_OVERAGE=2.0
SEVERITY_HIGH_OVERAGE=5.0
SEVERITY_CRITICAL_OVERAGE=10.0
SEVERITY_CRITICAL_RATE=0.5

# --- API -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
MAX_ALERTS_IN_MEMORY=500

# --- Notifications -------------------------------------------------------
# auto | local | cloudwatch | sns
#   auto       -> use CloudWatch/SNS when configured + credentials resolve,
#                 otherwise fall back to local file mode
#   local      -> always write alerts to ALERT_LOG_FILE (safe default)
NOTIFY_PROVIDER=auto
ALERT_LOG_FILE=./backend/data/alerts/alerts.log
ALERT_EXPORT_FILE=./backend/data/alerts/alerts.json

# --- AWS (optional) ------------------------------------------------------
# Credentials are NEVER stored here. boto3 resolves them from the standard
# chain: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials,
# AWS_PROFILE, or the EC2/ECS IAM role.
AWS_REGION=us-east-1
# AWS_PROFILE=default
#
# CloudWatch Logs (set NOTIFY_PROVIDER=cloudwatch or rely on auto)
# CLOUDWATCH_LOG_GROUP=/aws/codeathon/log-anomaly-detector
# CLOUDWATCH_LOG_STREAM=anomaly-alerts
#
# SNS (set NOTIFY_PROVIDER=sns or rely on auto)
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:log-anomaly-alerts
#
# Keep delivery failures from breaking the monitor
AWS_FAIL_SILENTLY=true
